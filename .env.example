# Copy to .env.local. Never commit credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
ADMIN_EMAIL=owner@example.com
# Generate using npm run admin:password, then paste the scrypt hash here.
ADMIN_PASSWORD_HASH=
# Set your exact HTTPS website origin on Vercel. Locally use http://localhost:4173.
APP_ORIGIN=http://localhost:4173
